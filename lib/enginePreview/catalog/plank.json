            "all": [
              { "metric": "body_line", "op": "gte", "value": 148 },
              { "metric": "body_tilt", "op": "gte", "value": 55 },
              { "metric": "knee_angle", "op": "gte", "value": 150 },
              {
                "any": [
                  { "metric": "elbow_angle", "op": "gte", "value": 155 },
                  {
                    "all": [
                      { "metric": "elbow_angle", "op": "gte", "value": 72 },
                      { "metric": "elbow_angle", "op": "lte", "value": 108 },
                      { "metric": "elbow_floor", "op": "gte", "value": -0.045 }
                    ]
                  }
                ]
              }
            ]
          }
        },
        "rest": {
          "description": "Standing, kneeling, collapsed, or arms neither locked nor in a forearm plank",
          "when": {
            "any": [
              { "metric": "body_line", "op": "lt", "value": 148 },
              { "metric": "body_tilt", "op": "lt", "value": 55 },
              { "metric": "knee_angle", "op": "lt", "value": 150 },
              {
                "all": [
                  { "metric": "elbow_angle", "op": "lt", "value": 155 },
                  {
                    "any": [
                      { "metric": "elbow_angle", "op": "lt", "value": 72 },
                      { "metric": "elbow_angle", "op": "gt", "value": 108 },
                      { "metric": "elbow_floor", "op": "lt", "value": -0.045 }
                    ]
                  }
                ]
              }
            ]
