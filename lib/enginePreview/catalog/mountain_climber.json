{
  "id": "mountain_climber",
  "display_name": "Mountain climber",
  "review": {
    "skeleton": true,
    "live": false
  },
  "type": "repetition",
  "lock": "require_profile",
  "unsupported_view": "hint_only",
  "min_rep_duration": 0.16,
  "identity": {
    "kind": "mountain_climber",
    "same_view": true,
    "min_active_duration": 0.1,
    "reject_span_growth": 0.04,
    "required_metrics": ["left_knee_dx", "right_knee_dx", "torso_tilt"],
    "ranges": {
      "left_knee_dx": [0.05, 3.2],
      "right_knee_dx": [0.05, 3.2],
      "torso_tilt": [40, 90]
    }
  },
  "camera_elevation": {
    "mode": "auto",
    "sample_idle_frames": 10
  },
  "placement": {
    "box_width": 88,
    "box_height": 50,
    "box_x": 6,
    "box_y": 30,
    "silhouette": "plank",
    "required_points": [
      "nose",
      "left_shoulder||right_shoulder",
      "left_hip",
      "right_hip",
      "left_knee",
      "right_knee",
      "left_wrist||right_wrist"
    ]
  },
  "counter": {
    "trigger_phase": "end_range",
    "from_phases": ["idle", "eccentric"],
    "min_descent_duration": 0.08
  },
  "grade": {
    "mode": "depth_only",
    "require_depth": true,
    "depth_metric_profile": "min_knee_dx",
    "ideal_profile": 0.4,
    "worst_profile": 1.15,
    "track_phases": ["eccentric", "end_range"]
  },
  "views": {
    "profile": {
      "metrics": [
        { "id": "torso_tilt", "kind": "tilt_from_vertical", "points": ["left_shoulder", "left_hip"], "side": "best" },
        { "id": "left_knee_dx", "kind": "norm_dx", "a": "left_knee", "b": "left_shoulder", "ref_a": "left_shoulder", "ref_b": "left_hip" },
        { "id": "right_knee_dx", "kind": "norm_dx", "a": "right_knee", "b": "right_shoulder", "ref_a": "right_shoulder", "ref_b": "right_hip" },
        { "id": "min_knee_dx", "kind": "min_of", "of": ["left_knee_dx", "right_knee_dx"] },
        { "id": "max_knee_dx", "kind": "max_of", "of": ["left_knee_dx", "right_knee_dx"] },
        { "id": "knee_dx_diff", "kind": "abs_diff", "of": ["left_knee_dx", "right_knee_dx"] },
        { "id": "left_ankle_dx", "kind": "norm_dx", "a": "left_ankle", "b": "left_shoulder", "ref_a": "left_shoulder", "ref_b": "left_hip" },
        { "id": "right_ankle_dx", "kind": "norm_dx", "a": "right_ankle", "b": "right_shoulder", "ref_a": "right_shoulder", "ref_b": "right_hip" },
        { "id": "min_ankle_dx", "kind": "min_of", "of": ["left_ankle_dx", "right_ankle_dx"] }
      ],
      "phase_order": ["idle", "end_range", "eccentric"],
      "phases": {
        "idle": {
          "description": "High plank — both legs long, arms planted",
          "when": {
            "all": [
              { "metric": "torso_tilt", "op": "gte", "value": 50 },
              { "metric": "min_knee_dx", "op": "gte", "value": 1.35 },
              { "metric": "min_ankle_dx", "op": "gte", "value": 1.9 },
              { "metric": "knee_dx_diff", "op": "lte", "value": 0.28 }
            ]
          }
        },
        "end_range": {
          "description": "One knee and ankle travel to the chest; the other leg stays long",
          "when": {
            "all": [
              { "metric": "torso_tilt", "op": "gte", "value": 45 },
              { "metric": "min_knee_dx", "op": "lte", "value": 0.85 },
              { "metric": "max_knee_dx", "op": "gte", "value": 1.3 },
              { "metric": "knee_dx_diff", "op": "gte", "value": 0.55 },
              { "metric": "min_ankle_dx", "op": "lte", "value": 1.2 }
            ]
          }
        },
        "eccentric": {
          "description": "Driving or returning one knee toward the chest",
          "when": {
            "all": [
              { "metric": "torso_tilt", "op": "gte", "value": 45 },
              { "metric": "min_knee_dx", "op": "lt", "value": 1.35 },
              { "metric": "knee_dx_diff", "op": "gte", "value": 0.22 }
            ]
          }
        }
      }
    }
  }
}
