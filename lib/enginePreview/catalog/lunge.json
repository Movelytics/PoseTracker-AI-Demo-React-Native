{
  "id": "lunge",
  "display_name": "Lunge",
  "review": {
    "skeleton": true,
    "live": false
  },
  "type": "repetition",
  "lock": "auto",
  "unsupported_view": "hint_only",
  "min_rep_duration": 0.8,
  "identity": {
    "kind": "lunge",
    "same_view": true,
    "min_active_duration": 0.3,
    "reject_span_growth": 0.04,
    "required_metrics": ["left_thigh_y", "right_thigh_y", "hips_level"],
    "ranges": {
      "left_thigh_y": [0, 0.55],
      "right_thigh_y": [0, 0.55],
      "hips_level": [0.35, 1],
      "knees_level": [0, 1]
    }
  },
  "camera_elevation": {
    "mode": "auto",
    "sample_idle_frames": 12
  },
  "placement": {
    "padding_horizontal": 20,
    "padding_vertical": 10,
    "silhouette": "full",
    "required_points": [
      "nose",
      "left_shoulder||right_shoulder",
      "left_hip",
      "right_hip",
      "left_knee",
      "right_knee",
      "left_ankle||right_ankle"
    ]
  },
  "counter": {
    "trigger_phase": "idle",
    "from_phases": ["eccentric", "end_range"],
    "min_descent_duration": 0.3
  },
  "grade": {
    "mode": "depth_only",
    "require_depth": true,
    "depth_metric_face": "min_thigh_y",
    "depth_metric_profile": "min_knee_angle",
    "ideal_face": 0.04,
    "worst_face": 0.14,
    "ideal_profile": 90,
    "worst_profile": 130,
    "track_phases": ["eccentric", "end_range"]
  },
  "views": {
    "face": {
      "metrics": [
        { "id": "hips_level", "kind": "alignment_horizontal", "points": ["left_hip", "right_hip"], "side": "left" },
        { "id": "knees_level", "kind": "alignment_horizontal", "points": ["left_knee", "right_knee"], "side": "left" },
        { "id": "left_thigh_y", "kind": "relative_y", "a": "left_knee", "b": "left_hip" },
        { "id": "right_thigh_y", "kind": "relative_y", "a": "right_knee", "b": "right_hip" },
        { "id": "min_thigh_y", "kind": "min_of", "of": ["left_thigh_y", "right_thigh_y"] },
        { "id": "max_thigh_y", "kind": "max_of", "of": ["left_thigh_y", "right_thigh_y"] },
        { "id": "thigh_y_diff", "kind": "abs_diff", "of": ["left_thigh_y", "right_thigh_y"] },
        { "id": "left_shin_y", "kind": "relative_y", "a": "left_ankle", "b": "left_knee" },
        { "id": "right_shin_y", "kind": "relative_y", "a": "right_ankle", "b": "right_knee" },
        { "id": "min_shin_y", "kind": "min_of", "of": ["left_shin_y", "right_shin_y"] }
      ],
      "phase_order": ["idle", "end_range", "eccentric"],
      "phases": {
        "idle": {
          "description": "Standing — hips level, both thighs long, knees level",
          "when": {
            "all": [
              { "metric": "hips_level", "op": "gte", "value": 0.75 },
              { "metric": "knees_level", "op": "gte", "value": 0.7 },
              { "metric": "min_thigh_y", "op": "gte", "value": 0.16 },
              { "metric": "thigh_y_diff", "op": "lte", "value": 0.06 }
            ]
          }
        },
        "end_range": {
          "description": "Both hips dropped and still level; one hip closed on its knee, the other thigh stays long as that knee goes to the floor",
          "when": {
            "all": [
              { "metric": "hips_level", "op": "gte", "value": 0.7 },
              { "metric": "knees_level", "op": "lte", "value": 0.55 },
              { "metric": "min_thigh_y", "op": "lte", "value": 0.1 },
              { "metric": "max_thigh_y", "op": "gte", "value": 0.16 },
              { "metric": "thigh_y_diff", "op": "gte", "value": 0.08 }
            ]
          }
        },
        "eccentric": {
          "description": "Hips dropping together; one knee staying, the other lowering",
          "when": {
            "all": [
              { "metric": "hips_level", "op": "gte", "value": 0.7 },
              { "metric": "min_thigh_y", "op": "lt", "value": 0.16 },
              { "metric": "min_thigh_y", "op": "gt", "value": 0.1 },
              { "metric": "thigh_y_diff", "op": "gte", "value": 0.05 },
              { "metric": "knees_level", "op": "lt", "value": 0.75 }
            ]
          }
        }
      }
    },
    "profile": {
      "metrics": [
        { "id": "hips_level", "kind": "alignment_horizontal", "points": ["left_hip", "right_hip"], "side": "left" },
        { "id": "knees_level", "kind": "alignment_horizontal", "points": ["left_knee", "right_knee"], "side": "left" },
        { "id": "left_thigh_y", "kind": "relative_y", "a": "left_knee", "b": "left_hip" },
        { "id": "right_thigh_y", "kind": "relative_y", "a": "right_knee", "b": "right_hip" },
        { "id": "min_thigh_y", "kind": "min_of", "of": ["left_thigh_y", "right_thigh_y"] },
        { "id": "max_thigh_y", "kind": "max_of", "of": ["left_thigh_y", "right_thigh_y"] },
        { "id": "thigh_y_diff", "kind": "abs_diff", "of": ["left_thigh_y", "right_thigh_y"] },
        { "id": "left_shin_y", "kind": "relative_y", "a": "left_ankle", "b": "left_knee" },
        { "id": "right_shin_y", "kind": "relative_y", "a": "right_ankle", "b": "right_knee" },
        { "id": "min_shin_y", "kind": "min_of", "of": ["left_shin_y", "right_shin_y"] },
        { "id": "left_knee_angle", "kind": "angle3", "points": ["left_hip", "left_knee", "left_ankle"], "side": "left" },
        { "id": "right_knee_angle", "kind": "angle3", "points": ["right_hip", "right_knee", "right_ankle"], "side": "right" },
        { "id": "min_knee_angle", "kind": "min_of", "of": ["left_knee_angle", "right_knee_angle"] }
      ],
      "phase_order": ["idle", "end_range", "eccentric"],
      "phases": {
        "idle": {
          "description": "Standing in profile — hips level, legs extended",
          "when": {
            "all": [
              { "metric": "hips_level", "op": "gte", "value": 0.75 },
              { "metric": "min_thigh_y", "op": "gte", "value": 0.16 },
              { "metric": "thigh_y_diff", "op": "lte", "value": 0.06 },
              { "metric": "min_knee_angle", "op": "gte", "value": 150 }
            ]
          }
        },
        "end_range": {
          "description": "Hips level and dropped; front thigh closed, rear knee toward the floor (~90°)",
          "when": {
            "all": [
              { "metric": "hips_level", "op": "gte", "value": 0.7 },
              { "metric": "knees_level", "op": "lte", "value": 0.55 },
              { "metric": "min_thigh_y", "op": "lte", "value": 0.1 },
              { "metric": "max_thigh_y", "op": "gte", "value": 0.16 },
              { "metric": "thigh_y_diff", "op": "gte", "value": 0.08 },
              { "metric": "min_knee_angle", "op": "lte", "value": 120 }
            ]
          }
        },
        "eccentric": {
          "description": "Stepping and dropping both hips; one knee stays, the other lowers",
          "when": {
            "all": [
              { "metric": "hips_level", "op": "gte", "value": 0.7 },
              { "metric": "min_thigh_y", "op": "lt", "value": 0.16 },
              { "metric": "min_thigh_y", "op": "gt", "value": 0.1 },
              { "metric": "thigh_y_diff", "op": "gte", "value": 0.05 }
            ]
          }
        }
      }
    }
  }
}
